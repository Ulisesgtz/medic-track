{
    "swagger": "2.0",
    "info": {
        "description": "Backend API for account/children signup and the país/estado catalog.\nSee contracts/post-accounts.md and contracts/get-catalog.md under\nspecs/001-registro-cuenta-usuario/ for the source-of-truth prose contracts.",
        "title": "PediTrack API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/accounts": {
            "post": {
                "description": "Creates a padre/tutor account, optionally with one or more children in the\nsame request. A brand-new account always starts on the free plan, which\nallows at most 1 child (FR-007) — enforced server-side regardless of what\nthe client already validated. No login/password is accepted here (FR-009).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "accounts"
                ],
                "summary": "Create an account (tutor + optional children)",
                "parameters": [
                    {
                        "description": "Account (and optional children) to create",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_account.createAccountRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal_account.accountResponse"
                        }
                    },
                    "400": {
                        "description": "Missing/invalid field, e.g. a malformed email or future birth date",
                        "schema": {
                            "$ref": "#/definitions/ValidationErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Email already in use",
                        "schema": {
                            "$ref": "#/definitions/EmailConflictResponse"
                        }
                    },
                    "422": {
                        "description": "Free plan already has 1 child; upgrade required",
                        "schema": {
                            "$ref": "#/definitions/FreemiumLimitResponse"
                        }
                    },
                    "500": {
                        "description": "Unexpected server error",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/catalog/countries": {
            "get": {
                "description": "Read-only catalog used to populate the país selector (contracts/get-catalog.md).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "catalog"
                ],
                "summary": "List countries",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/internal_catalog.countryResponse"
                            }
                        }
                    },
                    "500": {
                        "description": "Unexpected server error",
                        "schema": {
                            "$ref": "#/definitions/NotFoundResponse"
                        }
                    }
                }
            }
        },
        "/catalog/countries/{countryCode}/states": {
            "get": {
                "description": "Used to populate the estado selector. Returns an empty array if the country\nhas no subdivisions in the catalog (contracts/get-catalog.md).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "catalog"
                ],
                "summary": "List states/provinces for a country",
                "parameters": [
                    {
                        "type": "string",
                        "example": "MX",
                        "description": "ISO country code",
                        "name": "countryCode",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/internal_catalog.stateResponse"
                            }
                        }
                    },
                    "404": {
                        "description": "countryCode not found in catalog",
                        "schema": {
                            "$ref": "#/definitions/NotFoundResponse"
                        }
                    },
                    "500": {
                        "description": "Unexpected server error",
                        "schema": {
                            "$ref": "#/definitions/NotFoundResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "EmailConflictResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "email_already_exists"
                },
                "message": {
                    "type": "string",
                    "example": "Email is already in use"
                }
            }
        },
        "ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "internal_error"
                },
                "message": {
                    "type": "string",
                    "example": "Could not create account"
                }
            }
        },
        "FieldError": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string",
                    "example": "email"
                },
                "message": {
                    "type": "string",
                    "example": "invalid email format"
                }
            }
        },
        "FreemiumLimitResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "freemium_child_limit_exceeded"
                },
                "limit": {
                    "type": "integer",
                    "example": 1
                },
                "message": {
                    "type": "string",
                    "example": "The free plan includes only one child per account"
                },
                "received": {
                    "type": "integer",
                    "example": 2
                }
            }
        },
        "NotFoundResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "country_not_found"
                },
                "message": {
                    "type": "string",
                    "example": "Country not found in catalog"
                }
            }
        },
        "ValidationErrorResponse": {
            "type": "object",
            "properties": {
                "details": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/FieldError"
                    }
                },
                "error": {
                    "type": "string",
                    "example": "validation_error"
                },
                "message": {
                    "type": "string",
                    "example": "One or more fields are invalid"
                }
            }
        },
        "internal_account.accountResponse": {
            "type": "object",
            "properties": {
                "children": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_account.childResponse"
                    }
                },
                "countryCode": {
                    "type": "string",
                    "example": "MX"
                },
                "email": {
                    "type": "string",
                    "example": "ana@example.com"
                },
                "firstName": {
                    "type": "string",
                    "example": "Ana"
                },
                "id": {
                    "type": "string",
                    "example": "e5f6a7b8-0000-0000-0000-000000000000"
                },
                "lastName": {
                    "type": "string",
                    "example": "Gómez"
                },
                "plan": {
                    "type": "string",
                    "example": "free"
                },
                "stateCode": {
                    "type": "string",
                    "example": "MX-JAL"
                }
            }
        },
        "internal_account.childResponse": {
            "type": "object",
            "properties": {
                "birthDate": {
                    "type": "string",
                    "example": "2020-01-15"
                },
                "firstName": {
                    "type": "string",
                    "example": "Luis"
                },
                "height": {
                    "type": "number",
                    "example": 95.5
                },
                "id": {
                    "type": "string",
                    "example": "a1b2c3d4-0000-0000-0000-000000000000"
                },
                "lastName": {
                    "type": "string",
                    "example": "Gómez"
                },
                "weight": {
                    "type": "number",
                    "example": 14.2
                }
            }
        },
        "internal_account.createAccountRequest": {
            "type": "object",
            "properties": {
                "children": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_account.createChildRequest"
                    }
                },
                "countryCode": {
                    "type": "string",
                    "example": "MX"
                },
                "email": {
                    "type": "string",
                    "example": "ana@example.com"
                },
                "firstName": {
                    "type": "string",
                    "example": "Ana"
                },
                "lastName": {
                    "type": "string",
                    "example": "Gómez"
                },
                "stateCode": {
                    "type": "string",
                    "example": "MX-JAL"
                }
            }
        },
        "internal_account.createChildRequest": {
            "type": "object",
            "properties": {
                "birthDate": {
                    "type": "string",
                    "example": "2020-01-15"
                },
                "firstName": {
                    "type": "string",
                    "example": "Luis"
                },
                "height": {
                    "type": "number",
                    "example": 95.5
                },
                "lastName": {
                    "type": "string",
                    "example": "Gómez"
                },
                "weight": {
                    "type": "number",
                    "example": 14.2
                }
            }
        },
        "internal_catalog.countryResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "MX"
                },
                "name": {
                    "type": "string",
                    "example": "México"
                }
            }
        },
        "internal_catalog.stateResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "MX-JAL"
                },
                "name": {
                    "type": "string",
                    "example": "Jalisco"
                }
            }
        }
    }
}